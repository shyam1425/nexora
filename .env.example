# ---------------------------------------------------------------------------
# 360 WorkFox Tech - Environment Configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=production
APP_NAME="360 WorkFox Tech"
APP_URL=https://your-domain.example
# Public base URL used in emails/notifications (no trailing slash)

# --- Database (MySQL 8) ----------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Providers with a publicly-trusted certificate: append ?ssl=true
DATABASE_URL="mysql://workfox:CHANGE_ME@127.0.0.1:3306/workfox_tech"
# Optional: CA certificate for a provider that signs with its own certificate
# authority (for example a default Aiven service). Accepts PEM text, PEM with
# escaped \n, or the base64 encoding of either. Leave unset when DATABASE_URL
# already uses ?ssl=true.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Session / Crypto ------------------------------------------------------
# 32+ byte random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Session lifetime in hours
SESSION_TTL_HOURS=12

# --- Rate limiting ---------------------------------------------------------
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Trust the x-forwarded-for / x-real-ip headers set by a reverse proxy.
# Leave unset (false) when the app is reached directly: forwarding headers are
# client-controlled, so an unset value reports the caller as "unknown" and the
# per-IP rate-limit buckets collapse into one stricter global bucket.
# Set to true only when exactly one trusted proxy is in front and it controls
# those headers (see DEPLOYMENT.md "Client address and proxies").
TRUST_PROXY=

# --- Private document storage ---------------------------------------------
# local = node filesystem (private folder outside the public web root)
# s3    = S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
STORAGE_MAX_UPLOAD_MB=10
# Required when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
# Optional: custom S3-compatible endpoint (MinIO, R2, Wasabi, ...).
# Leave empty for AWS S3 itself. Must be an absolute http(s) URL.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: temporary-credential (STS) session token
S3_SESSION_TOKEN=
# Path-style addressing: true for MinIO/self-hosted gateways, false for AWS.
# Defaults to true when S3_ENDPOINT is set, otherwise false.
S3_FORCE_PATH_STYLE=

# --- Notification adapters -------------------------------------------------
# console = log only (dev), smtp = real email delivery
EMAIL_DRIVER=console
EMAIL_FROM="no-reply@your-domain.example"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Payroll / HR defaults -------------------------------------------------
DEFAULT_CURRENCY=INR
PAYROLL_WORKING_DAYS=22

# --- Seed bootstrap (used by `npm run db:seed` only) -----------------------
SEED_ADMIN_EMAIL=admin@workfox.tech
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_DEMO_DATA=false


# --- Runtime / smoke checks ------------------------------------------------
PORT=3000
# Set by a trusted deployment smoke runner, for example:
# SMOKE_BASE_URL=https://your-domain.example
